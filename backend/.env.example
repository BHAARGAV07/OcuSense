# ── Database (Supabase) ──────────────────────────────
DATABASE_URL=postgresql://postgres.xxxxxxxx:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# ── Auth / JWT ────────────────────────────────────────
JWT_SECRET=<generate a long random string — e.g. `openssl rand -hex 32`>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Environmental Data APIs ──────────────────────────
GOOGLE_POLLEN_API_KEY=<your Pollen API key — from Google Cloud Console>
# Open-Meteo needs no key — no variable required

# ── App Config ────────────────────────────────────────
ENVIRONMENT=development          # development | production
DEBUG=true                       # false in production — controls whether stack traces are ever exposed
CORS_ORIGINS=http://localhost:*  # tighten this once the Flutter app has a fixed origin/scheme

# ── Intelligence Layer (configurable, per AI Decision Engine doc) ──
RISK_HUMIDITY_THRESHOLD=75
MIN_OBSERVATION_COUNT=5          # below this, trigger confidence = "Insufficient data"
TIME_WINDOW_HOURS=24             # environmental-to-symptom matching window
POLLEN_CACHE_TTL_HOURS=24
WEATHER_CACHE_TTL_HOURS=1
